# Salin ke .env lalu sesuaikan:  cp .env.example .env
# JANGAN commit file .env ke GitHub!

# ---------- Wajib diganti di production ----------
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32
ADMIN_EMAIL=admin@tokoku.id
ADMIN_PASSWORD=admin12345

# ---------- Profil toko awal ----------
STORE_NAME=Toko Kita
STORE_WHATSAPP=6281234567890
STORE_DESCRIPTION=Produk lokal berkualitas, pesan langsung via WhatsApp.
STORE_ADDRESS=Bandung, Jawa Barat

# ---------- Web ----------
# Domain frontend (pisahkan dengan koma kalau lebih dari satu)
CORS_ORIGINS=http://localhost:5173
# URL publik API (dipakai untuk link gambar kalau tidak memakai R2)
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Production (deploy/docker-compose.prod.yml) ----------
API_DOMAIN=api.tokoku.id
POSTGRES_USER=umkm
POSTGRES_PASSWORD=ganti-password-db

# ---------- Cloudflare R2 (opsional) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- AWS SQS untuk notifikasi Telegram (opsional) ----------
AWS_REGION=ap-southeast-1
SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
